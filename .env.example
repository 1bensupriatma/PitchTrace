PORT=8005
APP_ORIGIN=http://127.0.0.1:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Maps Platform key with Places API (New) enabled. Keep this server-side only.
GOOGLE_PLACES_API_KEY=

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8005/api/auth/google/callback

# Use long random values in production. DATA_ENCRYPTION_KEY encrypts sessions and history at rest.
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
DATA_DIRECTORY=./data
